# 必須。どちらかが欠けていると起動時に停止します。
NOTEPM_API_TOKEN=your_api_token_here
NOTEPM_TEAM=your_team_here

# 検索結果の本文を切り詰める文字数（任意、既定 200）
# 0 以上の整数を指定します。0 は本文を丸ごと省略する指定です。
# 整数として読めない値や負の値を渡すと、起動時に停止します。
# 詳細取得は全文を返すため、この設定の影響を受けません。
# NOTEPM_MAX_BODY_LENGTH=200

# ツール説明の差し替え（任意、既定は実装の説明文）
# NOTEPM_SEARCH_DESCRIPTION=カスタム検索ツール説明文をここに書きます
# NOTEPM_PAGE_DETAIL_DESCRIPTION=カスタム詳細取得ツール説明文をここに書きます

# デバッグ用（任意、既定は無効）
# 1 / true / yes / on のいずれかで有効になります。
# 有効にするとハンドラを抜けた例外がそのまま送出され、サーバープロセスが停止します。
# 常駐運用では設定しないでください。
# NOTEPM_RAISE_EXCEPTIONS=1
